[Unit]
Description=autoship hosted deploy API
After=network.target docker.service nginx.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/autoship/api
Environment=AUTOSHIP_BIND=127.0.0.1
Environment=AUTOSHIP_PORT=9100
Environment=AUTOSHIP_DOMAIN=autoship.fun
Environment=AUTOSHIP_DEPLOY_ROOT=/opt/autoship
Environment=AUTOSHIP_DEPLOY_SCRIPT=/opt/autoship/api/deploy_release.sh
EnvironmentFile=/opt/autoship/api/api.env
ExecStart=/usr/bin/python3 /opt/autoship/api/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
